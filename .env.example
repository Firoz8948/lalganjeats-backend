# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Local Postgres example — production uses RDS endpoint instead:
# DATABASE_URL=postgresql://lalganjeats:PASSWORD@lalganjeats-db.xxxx.ap-south-1.rds.amazonaws.com:5432/lalganjeats
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/lalganjeats

SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated origins (no spaces required; spaces are trimmed)
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

RENFLAIR_API_KEY=
GOOGLE_MAPS_API_KEY=
SMS_BRAND_NAME=LalganjEats
DELIVERY_OFFER_WAIT_SECONDS=10

# Partner report delivery (SMTP email + Meta WhatsApp Cloud API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0

# Storage: local (dev) or bunny (production CDN)
STORAGE_BACKEND=local
BUNNY_STORAGE_ZONE=lalganjeats-media
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_HOST=sg.storage.bunnycdn.com
BUNNY_CDN_URL=https://lalganjeats-cdn.b-cdn.net
