# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development

# Local Postgres example — production uses RDS endpoint instead:
# DATABASE_URL=postgresql://lalganjeats:PASSWORD@lalganjeats-db.xxxx.ap-south-1.rds.amazonaws.com:5432/lalganjeats
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/lalganjeats

SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated origins (no spaces required; spaces are trimmed)
# Website + Capacitor Android/iOS app origins.
# Dev browser: http://localhost:4200
# Native app WebView: https://app.lalganjeats.com (set in capacitor.config.ts hostname)
CORS_ORIGINS=https://lalganjeats.com,https://www.lalganjeats.com,https://app.lalganjeats.com,https://live.lalganjeats.com,https://hotel.lalganjeats.com,https://dp.lalganjeats.com,http://localhost:4200
FRONTEND_URL=https://lalganjeats.com

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# PayU India — live prepaid checkout
# From PayU Dashboard → Payment Gateway → Key Salt Details (use Salt v1)
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
# Optional — if dashboard also shows OAuth / API client credentials
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_MODE=live
# Must be reachable by PayU (your public API host, no trailing slash)
API_PUBLIC_URL=https://api.lalganjeats.com

RENFLAIR_API_KEY=
GOOGLE_MAPS_API_KEY=
SMS_BRAND_NAME=LalganjEats
DELIVERY_OFFER_WAIT_SECONDS=10

# Partner report delivery (SMTP email + Meta WhatsApp Cloud API)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v22.0

# Storage: local (dev) or bunny (production CDN)
STORAGE_BACKEND=local
BUNNY_STORAGE_ZONE=lalganjeats-media
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_HOST=sg.storage.bunnycdn.com
BUNNY_CDN_URL=https://lalganjeats-cdn.b-cdn.net
